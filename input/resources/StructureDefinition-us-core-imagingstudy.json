  "kind": "resource",
  "abstract": false,
  "type": "ImagingStudy",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/ImagingStudy",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "ImagingStudy",
        "path": "ImagingStudy",
        "mustSupport": false
      },
      {
        "id": "ImagingStudy.identifier",
        "path": "ImagingStudy.identifier",
        "slicing": {
          "discriminator": [
            {
              "type": "pattern",
              "path": "$this"
            }
          ],
          "rules": "open",
          "description": "Slice on the identifier system to require the DICOM Study Instance UID."
        },
        "short": "Identifiers for the whole study, including the DICOM Study Instance UID",
        "comment": "Other business identifiers such as an accession number can also be present alongside the DICOM Study Instance UID.",
        "min": 1,
        "mustSupport": true
      },
      {
        "id": "ImagingStudy.identifier:studyInstanceUID",
        "path": "ImagingStudy.identifier",
        "sliceName": "studyInstanceUID",
        "short": "DICOM Study Instance UID",
        "comment": "The DICOM Study Instance UID, represented as an Identifier with system `urn:dicom:uid` and a value of the form `urn:oid:1.2.250.1...`.",
        "min": 1,
        "max": "1",
        "patternIdentifier": {
          "system": "urn:dicom:uid"
        },
        "mustSupport": true
      },
      {
        "id": "ImagingStudy.status",
