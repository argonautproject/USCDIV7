# codespell configuration for this IG repo.
# Read automatically by the shared pre-commit hook in ~/Documents/FHIR/.githooks/.
#
# ignore-words-list holds terms codespell flags that are correct in a FHIR or
# health IT context:
#   intensional - a value set defined by rules rather than an enumerated list
#                 (the counterpart of "extensional"); not a typo for intentional
#   ehr         - Electronic Health Record; not a typo for "her"
#   promis      - Patient-Reported Outcomes Measurement Information System, a
#                 measure name used in the screening and assessment value sets;
#                 not a typo for "promise"
[codespell]
ignore-words-list = intensional,ehr,promis
